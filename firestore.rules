rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsHub(hubId) {
      let hub = get(/databases/$(database)/documents/hubs/$(hubId));
      let accountManaged = hub.data.keys().hasAny(['role_mode'])
                           && hub.data.role_mode == 'account';
      let ownerMatches = hub.data.keys().hasAny(['owner_uid'])
                         && hub.data.owner_uid == request.auth.uid;
      let legacyCreatorMatches = hub.data.keys().hasAny(['created_by'])
                                 && hub.data.created_by == request.auth.uid;
      return signedIn()
             && (
               ownerMatches ||
               (!accountManaged && legacyCreatorMatches)
             );
    }

    function accountManagedHub(hubId) {
      let hub = get(/databases/$(database)/documents/hubs/$(hubId));
      return hub.data.keys().hasAny(['role_mode'])
             && hub.data.role_mode == 'account';
    }

    function belongsToHub(hubId) {
      return signedIn()
             && hubAcceptingActivity(hubId)
             && (
               // Legacy password-only hubs predate membership documents.
               // Keep their existing signed-in behavior until they are claimed;
               // account-managed hubs are membership-gated immediately.
               !accountManagedHub(hubId) ||
               ownsHub(hubId) ||
               exists(/databases/$(database)/documents/hubs/$(hubId)/members/$(request.auth.uid))
             );
    }

    function hubAcceptingActivity(hubId) {
      let hub = get(/databases/$(database)/documents/hubs/$(hubId));
      return !hub.data.keys().hasAny(['lifecycle_state'])
             || hub.data.lifecycle_state != 'deleting';
    }

    match /matches/{matchId} {
      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid;

      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn()
                    && resource.data.uid == request.auth.uid;
    }

    match /hubs/{hubId} {
      allow get: if belongsToHub(hubId);
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.created_by == request.auth.uid
                    && request.resource.data.password_hash is string
                    && request.resource.data.name is string;

      // Account-managed private hubs are mutated and recursively deleted only
      // through capability-checked Admin API routes so cleanup cannot be
      // bypassed by a direct client write.
      allow update, delete: if ownsHub(hubId)
                            && !accountManagedHub(hubId);

      // Membership roles, invitations, messages, and Discord configuration are
      // server-authoritative. Firebase Admin-backed website routes enforce hub
      // capabilities and bypass client rules; desktop/browser clients cannot
      // promote themselves or alter ownership by writing these collections.
      match /members/{uid} {
        allow read, write: if false;
      }

      match /matches/{matchId} {
        allow get, list: if belongsToHub(hubId);

        // Web Replay grants are server-authoritative. A client first writes the
        // match, then the authenticated website endpoint atomically adds the
        // replay pointer and its live-membership grant.
        allow create: if belongsToHub(hubId)
                      && request.resource.data.uid == request.auth.uid
                      && !request.resource.data.keys().hasAny(['web_replay_id', 'webReplayId']);

        allow update: if belongsToHub(hubId)
                      && request.resource.data.uid == request.auth.uid
                      && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['web_replay_id', 'webReplayId']);

        allow delete: if belongsToHub(hubId)
                      && resource.data.uid == request.auth.uid;
      }
    }

    match /accountSync/{uid}/{document=**} {
      allow read, write: if signedIn()
                         && request.auth.uid == uid;
    }

    // Everything else is server-only unless explicitly opened above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
